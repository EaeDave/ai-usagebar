<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ai-usagebar-tray</AssemblyName>
    <RootNamespace>AiUsagebarTray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>ai-usagebar tray</Product>
    <Description>Windows system-tray widget for ai-usagebar (Claude/GPT/GLM/OpenRouter usage).</Description>
  </PropertyGroup>

  <!-- Publishing a single self-contained exe is documented in README.md. -->

</Project>

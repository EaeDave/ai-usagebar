<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ai-usagebar-tray</AssemblyName>
    <RootNamespace>AiUsagebarTray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>ai-usagebar tray</Product>
    <Description>Windows system-tray widget for ai-usagebar (Claude/GPT/GLM/OpenRouter usage).</Description>
  </PropertyGroup>

  <!-- Publish defaults: a single self-contained x64 exe that runs without a
       preinstalled .NET runtime. Produce it with:
         dotnet publish -c Release
       Output: bin\Release\net8.0-windows\win-x64\publish\ai-usagebar-tray.exe -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- WinForms is not trimmer-safe; keep trimming off to avoid runtime
         MissingMethod surprises. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
